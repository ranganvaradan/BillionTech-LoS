# Staging review environment — NEVER use production database credentials here.
# Copy to .env.staging (gitignored) and adjust for your host.
# Do not commit real passwords.

POSTGRES_HOST=localhost
# Dedicated staging Postgres (example docker: -p 55432:5432). Do not reuse production DB.
POSTGRES_PORT=55432
POSTGRES_DB=los_core_staging
POSTGRES_USER=los_admin
POSTGRES_PASSWORD=CHANGE_ME

# Optional Redis / Rabbit if your local stack requires them
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=los_rabbit
RABBITMQ_PASSWORD=CHANGE_ME

# Credit Intelligence staging demo
# Leave blank for local staging review (permit-all + blank token allows APIs with warning).
CREDIT_INTELLIGENCE_INTERNAL_TOKEN=

SPRING_PROFILES_ACTIVE=staging

# Notes:
# - Create DB first: createdb los_core_staging  (or Docker / psql CREATE DATABASE)
# - allow-canonical-authority stays false in application-staging.yml
# - Do not point POSTGRES_DB at production los_core / losdb
