# Copy to infra/los/.env (or env) for local/prod compose — NEVER commit real values.
# Real secrets live only on the host (e.g. /opt/billiontech/apps/billiontechlos/.env).

POSTGRES_DB=losdb
POSTGRES_USER=losuser
POSTGRES_PASSWORD=CHANGE_ME

SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8083
DOCUMENT_STORAGE_PATH=/data/documents

JWT_SECRET=CHANGE_ME_LONG_RANDOM

# Frontend production uses Nginx reverse proxy. Keep as /api.
VITE_API_BASE_URL=/api

# Host port for los_ui (8080 — host nginx keeps port 80)
LOS_UI_HOST_PORT=8080

# Credinnov / Encore (sandbox or prod — set on host only)
ENCORE_BASE_URL=https://example.invalid/
ENCORE_API_USERNAME=CHANGE_ME
ENCORE_API_PASSWORD=CHANGE_ME

LOS_DOCUMENT_STORAGE=local
LOS_FILE_STORAGE_ROOT=/data/documents

# LOS → PLP integration
PLP_BASE_URL=http://172.17.0.1:8180
PLP_INTEGRATION_EMAIL=CHANGE_ME@example.invalid
PLP_INTEGRATION_PASSWORD=CHANGE_ME
PLP_LOS_INTEGRATION_API_KEY=CHANGE_ME

ANCHOR_PORTAL_URL=https://example.invalid/
PLP_INTEGRATION_DEFAULT_USER_PASSWORD=CHANGE_ME

# PayU (test merchant — set on host only)
PAYU_MERCHANT_KEY=CHANGE_ME
PAYU_MERCHANT_SALT=CHANGE_ME
PAYU_GATEWAY_URL=https://test.payu.in
LOS_PUBLIC_API_BASE_URL=https://example.invalid
LOS_BORROWER_UI_URL=https://example.invalid
LOS_CORS_ALLOWED_ORIGIN_PATTERNS=https://*.example.invalid
