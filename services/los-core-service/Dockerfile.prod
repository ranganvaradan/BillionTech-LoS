FROM maven:3.9.9-eclipse-temurin-17 AS build
WORKDIR /workspace
COPY pom.xml ./
COPY services ./services
RUN mvn -pl services/los-core-service -am -DskipTests package

FROM eclipse-temurin:17-jre-alpine
WORKDIR /app
RUN addgroup -S app && adduser -S app -G app && mkdir -p /data/documents && chown -R app:app /data /app
COPY --from=build /workspace/services/los-core-service/target/*.jar /app/los-core-service.jar
USER app
EXPOSE 8083
ENTRYPOINT ["java", "-jar", "/app/los-core-service.jar"]
